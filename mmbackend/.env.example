# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/messmate

# Long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Recommended ─────────────────────────────────────────────────────────────
# Your deployed frontend origin, for CORS. Vercel preview URLs are allowed
# automatically; this is for the production domain.
FRONTEND_URL=https://messmate.vercel.app

# Set this on your host only. Leave it unset (or "development") locally —
# production mode enforces a strict CORS origin allowlist.
# NODE_ENV=production
PORT=5000

# ── Photo storage (strongly recommended in production) ──────────────────────
# Without these the server writes uploads to local disk, which most hosts wipe
# on every redeploy — users' photos disappear. Free tier at cloudinary.com is
# far more than a campus app needs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
